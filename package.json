{
  "name": "dsh-web-fetch-chain",
  "version": "0.1.0",
  "description": "Fallback-chain web fetch provider for DeepSeek Harness: HTTP -> scrape.do -> Scrapfly -> Firecrawl.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "index.js",
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "web-fetch",
    "fetch-provider",
    "scrape.do",
    "scrapfly",
    "firecrawl"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "verify:dsh": "node scripts/verify-dsh.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/now-actuating/dsh-web-fetch-chain.git"
  },
  "bugs": "https://github.com/now-actuating/dsh-web-fetch-chain/issues",
  "homepage": "https://github.com/now-actuating/dsh-web-fetch-chain#readme",
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "versioning": {
      "kind": "independent",
      "repository": "https://github.com/now-actuating/dsh-web-fetch-chain.git"
    }
  }
}
